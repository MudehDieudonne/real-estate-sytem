PORT=3030
DATABASE_URL=mongodb+srv://user:pass@cluster/db
JWT_SECRET_KEY=replace_with_strong_secret
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3030
NODE_ENV=development

# OTP email sender webhook (optional in development)
# Build a tiny mail microservice or use provider endpoint that accepts:
# { to, subject, text, html } in JSON body.
OTP_EMAIL_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Facebook listing import
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_IMPORT_LIMIT=50
FACEBOOK_IMPORT_OWNER_EMAIL=

# AI extraction for Facebook listings. Any OpenAI-compatible chat completions endpoint can be used.
AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Twilio (Real SMS/WhatsApp OTP - Optional for Dev/Mock)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
