generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float
  img         String
  address     String
  city        String
  bedrooms    Int
  bathrooms   Int
  latitude    Float
  longitude   Float
  type        Type
  property    Property
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
}

enum Type {
  sale
  rent
}

enum Property {
  apartment
  house
  condo
  villa
  duplex
  townhouse
  land
}
